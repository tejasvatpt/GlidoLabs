{
  "name": "eclipse",
  "fonts": {
    "caption": { "family": "Montserrat", "file": "fonts/Montserrat.ttf", "weight": 700 },
    "emphasis": { "family": "Anton", "file": "fonts/Anton-Regular.ttf", "weight": 400 },
    "hook": { "family": "Anton", "file": "fonts/Anton-Regular.ttf", "weight": 400 }
  },
  "caption": {
    "fontSize": 0.0667,
    "lineHeight": 1.18,
    "wordGap": 0.2,
    "baselineY": 0.8,
    "maxWidth": 0.86,
    "color": "#FFFFFF",
    "activeColor": "#FFE81A",
    "activeBackground": "rgba(255, 214, 0, 0.22)",
    "shadow": "0 0.04em 0.18em rgba(0,0,0,0.55)",
    "emphasis": { "uppercase": true, "scale": 1.12, "color": "#FFFFFF" }
  },
  "hook": {
    "fontSize": 0.34,
    "maxWidth": 0.87,
    "headOverlap": 0.45,
    "minTopY": 0.04,
    "shortWordWidth": 0.6,
    "shortWordDrop": 0.35,
    "sideMarginX": 0.06,
    "color": "#FFFFFF",
    "accentColor": "#FFE81A",
    "shadow": "0 0.03em 0.12em rgba(0,0,0,0.45)",
    "box": { "color": "rgba(255, 221, 0, 0.38)", "radius": 0.02, "paddingX": 0.055, "paddingY": 0.037 }
  },
  "engine": {
    "maxWords": 4,
    "maxLinesFill": 1.6,
    "pauseBreakS": 0.35,
    "holdS": 0.0,
    "gapFillS": 0.25,
    "hookMinS": 1.0,
    "hookLeadS": 0.4,
    "minLetters": 4,
    "weights": { "energy": 0.25, "stretch": 0.15, "pause": 0.1, "lexical": 0.8 },
    "emphasisThreshold": 0.7,
    "emphasisMinLexical": 0.5,
    "hookThreshold": 0.55,
    "hookMinLexical": 0.6,
    "hookStemLetters": 5,
    "hookMinGapS": 4.0,
    "hooksPerMinute": 6
  }
}
